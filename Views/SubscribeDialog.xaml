<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="NtfyDesktop.Views.SubscribeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:NtfyDesktop.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind ViewModel.DialogTitle}"
    DefaultButton="Primary"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText}"
    SecondaryButtonText="Cancel"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Width="380" Spacing="14">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Topics may not be password-protected, so choose a name that's not easy to guess."
                TextWrapping="Wrap" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    AutomationProperties.AutomationId="EditTopic"
                    Header="Topic"
                    PlaceholderText="my-topic"
                    Text="{x:Bind ViewModel.Topic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="GenerateNameButton"
                    Command="{x:Bind ViewModel.GenerateNameCommand}"
                    Content="Generate name" />
            </Grid>

            <!--  Server / account picker: ntfy.sh, a saved account, or another server.  -->
            <ComboBox
                AutomationProperties.AutomationId="EditAccount"
                HorizontalAlignment="Stretch"
                Header="Server / account"
                ItemsSource="{x:Bind ViewModel.AccountOptions}"
                SelectedIndex="{x:Bind ViewModel.SelectedAccountIndex, Mode=TwoWay}" />

            <!--  Custom server URL + manual auth: only for "Use another server…".  -->
            <TextBox
                AutomationProperties.AutomationId="EditServerUrl"
                Header="Service URL"
                PlaceholderText="https://ntfy.example.com"
                Text="{x:Bind ViewModel.ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(ViewModel.ShowServerField), Mode=OneWay}" />

            <ComboBox
                AutomationProperties.AutomationId="EditAuthMode"
                HorizontalAlignment="Stretch"
                Header="Authentication"
                SelectedIndex="{x:Bind ViewModel.AuthIndex, Mode=TwoWay}"
                Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(ViewModel.ShowManualAuth), Mode=OneWay}">
                <ComboBoxItem Content="No authentication" />
                <ComboBoxItem Content="Access token" />
                <ComboBoxItem Content="Username &amp; password" />
            </ComboBox>

            <TextBox
                AutomationProperties.AutomationId="EditToken"
                Header="Access token"
                PlaceholderText="tk_..."
                Text="{x:Bind ViewModel.Token, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(ViewModel.ShowTokenField), Mode=OneWay}" />

            <TextBox
                AutomationProperties.AutomationId="EditUsername"
                Header="Username"
                Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(ViewModel.ShowUserPassFields), Mode=OneWay}" />

            <PasswordBox
                AutomationProperties.AutomationId="EditPassword"
                Header="Password"
                Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(ViewModel.ShowUserPassFields), Mode=OneWay}" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ValidationError, Mode=OneWay}"
                Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
