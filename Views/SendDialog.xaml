<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="NtfyDesktop.Views.SendDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:NtfyDesktop.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Publish notification"
    DefaultButton="Primary"
    PrimaryButtonText="Publish"
    SecondaryButtonText="Cancel"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <!--  Override the default ~548px cap so the publish form gets more room.  -->
        <x:Double x:Key="ContentDialogMaxWidth">800</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="620">
        <StackPanel Width="680" Spacing="12">
            <ComboBox
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="SendSubscription"
                DisplayMemberPath="DisplayName"
                Header="Subscribed topic"
                ItemsSource="{x:Bind ViewModel.Subscriptions}"
                PlaceholderText="Choose a subscribed topic, or type a server + topic below"
                SelectedItem="{x:Bind ViewModel.SelectedSubscription, Mode=TwoWay}" />

            <!--  Service URL + topic side by side, like the official ntfy dialog.  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    AutomationProperties.AutomationId="SendServer"
                    Header="Service URL"
                    Text="{x:Bind ViewModel.ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Grid.Column="1"
                    AutomationProperties.AutomationId="SendTopic"
                    Header="Topic name"
                    PlaceholderText="e.g. phil_alerts"
                    Text="{x:Bind ViewModel.Topic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <TextBox
                AutomationProperties.AutomationId="SendTitle"
                Header="Title (optional)"
                Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBox
                MinHeight="110"
                AcceptsReturn="True"
                AutomationProperties.AutomationId="SendMessage"
                Header="Message"
                PlaceholderText="What do you want to send?"
                Text="{x:Bind ViewModel.MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <CheckBox
                AutomationProperties.AutomationId="SendMarkdown"
                Content="Format as Markdown"
                IsChecked="{x:Bind ViewModel.Markdown, Mode=TwoWay}" />

            <ComboBox
                AutomationProperties.AutomationId="SendPriority"
                Header="Priority"
                SelectedIndex="{x:Bind ViewModel.PriorityIndex, Mode=TwoWay}">
                <ComboBoxItem Content="Min priority" />
                <ComboBoxItem Content="Low priority" />
                <ComboBoxItem Content="Default priority" />
                <ComboBoxItem Content="High priority" />
                <ComboBoxItem Content="Max priority" />
            </ComboBox>

            <TextBox
                AutomationProperties.AutomationId="SendTags"
                Header="Tags &amp; emojis (comma-separated)"
                PlaceholderText="warning, skull, backup"
                Text="{x:Bind ViewModel.Tags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="Other features">
                <StackPanel Spacing="12">
                    <TextBox
                        AutomationProperties.AutomationId="SendClick"
                        Header="Click URL"
                        PlaceholderText="https://example.com"
                        Text="{x:Bind ViewModel.ClickUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        AutomationProperties.AutomationId="SendAttachUrl"
                        Header="Attach file by URL"
                        PlaceholderText="https://example.com/file.zip"
                        Text="{x:Bind ViewModel.AttachUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        AutomationProperties.AutomationId="SendFilename"
                        Header="Filename (optional)"
                        Text="{x:Bind ViewModel.AttachFilename, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Attach local file" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                IsReadOnly="True"
                                PlaceholderText="No file chosen"
                                Text="{x:Bind ViewModel.LocalFileName, Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                Click="BrowseFile_Click"
                                Content="Browse…" />
                            <Button
                                Grid.Column="2"
                                Click="ClearFile_Click"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Clear"
                                Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(ViewModel.HasLocalFile), Mode=OneWay}">
                                <FontIcon FontSize="14" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <TextBox
                        AutomationProperties.AutomationId="SendEmail"
                        Header="Forward to email"
                        PlaceholderText="you@example.com"
                        Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        AutomationProperties.AutomationId="SendDelay"
                        Header="Delay delivery"
                        PlaceholderText="30min, or &quot;tomorrow, 10am&quot;"
                        Text="{x:Bind ViewModel.Delay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap">
                        <Run Text="For all send features and examples, see the" />
                        <Hyperlink NavigateUri="https://docs.ntfy.sh/publish/">ntfy publish documentation</Hyperlink><Run Text="." />
                    </TextBlock>
                </StackPanel>
            </Expander>

            <CheckBox
                AutomationProperties.AutomationId="SendPublishAnother"
                Content="Publish another (keep dialog open)"
                IsChecked="{x:Bind ViewModel.PublishAnother, Mode=TwoWay}" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
