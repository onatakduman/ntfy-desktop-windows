<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="NtfyDesktop.Views.TopicView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:NtfyDesktop.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NtfyDesktop.Models"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Top app bar  -->
        <Border
            Grid.Row="0"
            Padding="24,14"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.SelectedSubtitle, Mode=OneWay}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        AutomationProperties.AutomationId="MuteButton"
                        Click="Mute_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind helpers:XamlHelpers.MuteTooltip(ViewModel.SelectedIsMuted), Mode=OneWay}"
                        Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(ViewModel.CanActOnTopic), Mode=OneWay}">
                        <FontIcon FontSize="16" Glyph="{x:Bind helpers:XamlHelpers.MuteGlyph(ViewModel.SelectedIsMuted), Mode=OneWay}" />
                    </Button>
                    <Button
                        AutomationProperties.AutomationId="ClearButton"
                        Click="Clear_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Clear all notifications shown here">
                        <FontIcon FontSize="16" Glyph="&#xE74D;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!--  No subscriptions at all  -->
            <StackPanel
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind helpers:XamlHelpers.NoSubsVisibility(ViewModel.HasSubscriptions), Mode=OneWay}">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="48"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE91C;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="It looks like you don't have any subscriptions yet." />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Click 'Subscribe to topic' to create one. After that, you can send messages and they'll appear here."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    Click="SubscribeEmpty_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Subscribe to topic" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  Subscribed but no messages for this topic  -->
            <StackPanel
                MaxWidth="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind helpers:XamlHelpers.EmptyTopicVisibility(ViewModel.HasSubscriptions, ViewModel.HasMessages), Mode=OneWay}">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="48"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE7E7;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="You haven't received any notifications for this topic yet."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="To send a notification, type in the box below, or run this command:"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Border
                    Padding="14,10"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.ExampleCommand, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <Button
                            Grid.Column="1"
                            Click="CopyExample_Click"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Copy command">
                            <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!--  Message feed (chronological)  -->
            <ListView
                x:Name="MessagesList"
                Padding="20,12,20,12"
                AutomationProperties.AutomationId="MessagesList"
                ItemsSource="{x:Bind ViewModel.CurrentMessages}"
                SelectionMode="None"
                Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(ViewModel.HasMessages), Mode=OneWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:NtfyMessage">
                        <Border
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource OverlayCornerRadius}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  Icon  -->
                                <Image
                                    Grid.Column="0"
                                    Width="36"
                                    Height="36"
                                    VerticalAlignment="Top"
                                    Source="{x:Bind helpers:XamlHelpers.ImageFromUri(IconUri)}"
                                    Stretch="UniformToFill"
                                    Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(HasIcon)}" />

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind TimeDisplay}" />
                                        <Button
                                            Grid.Column="1"
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            Click="DeleteMessage_Click"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            ToolTipService.ToolTip="Delete">
                                            <FontIcon FontSize="13" Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>

                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Title}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind helpers:XamlHelpers.StringToVisibility(Title)}" />

                                    <!--  Plain body  -->
                                    <TextBlock
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind DisplayBody}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind helpers:XamlHelpers.InvertBoolToVisibility(IsMarkdown)}" />
                                    <!--  Markdown body (rendered in code-behind)  -->
                                    <TextBlock
                                        IsTextSelectionEnabled="True"
                                        Loaded="MarkdownBody_Loaded"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(IsMarkdown)}" />

                                    <!--  Image attachment  -->
                                    <Image
                                        MaxHeight="240"
                                        HorizontalAlignment="Left"
                                        Source="{x:Bind helpers:XamlHelpers.ImageFromUri(AttachmentUri)}"
                                        Stretch="Uniform"
                                        Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(HasImageAttachment)}" />
                                    <!--  Non-image attachment  -->
                                    <HyperlinkButton
                                        Padding="0"
                                        Click="Attachment_Click"
                                        Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(HasNonImageAttachment)}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="14" Glyph="&#xE723;" />
                                            <TextBlock Text="{x:Bind AttachmentLabel}" />
                                        </StackPanel>
                                    </HyperlinkButton>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border
                                            Padding="8,2"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="{StaticResource ControlCornerRadius}">
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Topic}" />
                                        </Border>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind TagsDisplay}"
                                            Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(HasTags)}" />
                                    </StackPanel>

                                    <!--  Action buttons  -->
                                    <ItemsControl
                                        ItemsSource="{x:Bind Actions}"
                                        Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(HasActions)}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:NtfyAction">
                                                <Button Click="Action_Click" Content="{x:Bind Label}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <HyperlinkButton
                                        Padding="0"
                                        Content="{x:Bind Click}"
                                        NavigateUri="{x:Bind ClickUri}"
                                        Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(HasClick)}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!--  Quick-publish compose bar  -->
        <Border
            Grid.Row="2"
            Padding="16,12"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(ViewModel.CanActOnTopic), Mode=OneWay}">
            <StackPanel Spacing="8">
                <Grid
                    ColumnSpacing="8"
                    Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(ViewModel.ComposeExpanded), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        PlaceholderText="Title"
                        Text="{x:Bind ViewModel.ComposeTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="130"
                        SelectedIndex="{x:Bind ViewModel.ComposePriorityIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Min" />
                        <ComboBoxItem Content="Low" />
                        <ComboBoxItem Content="Default" />
                        <ComboBoxItem Content="High" />
                        <ComboBoxItem Content="Max" />
                    </ComboBox>
                    <TextBox
                        Grid.Column="2"
                        PlaceholderText="Tags (comma-separated)"
                        Text="{x:Bind ViewModel.ComposeTags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton
                        Grid.Column="0"
                        IsChecked="{x:Bind ViewModel.ComposeExpanded, Mode=TwoWay}"
                        ToolTipService.ToolTip="More options">
                        <FontIcon FontSize="14" Glyph="&#xE70E;" />
                    </ToggleButton>
                    <TextBox
                        Grid.Column="1"
                        x:Name="ComposeBox"
                        AutomationProperties.AutomationId="ComposeBox"
                        KeyDown="ComposeBox_KeyDown"
                        PlaceholderText="Type a message here"
                        Text="{x:Bind ViewModel.ComposeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="2"
                        AutomationProperties.AutomationId="ComposeSend"
                        Command="{x:Bind ViewModel.SendComposeCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Send">
                        <FontIcon FontSize="14" Glyph="&#xE724;" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
