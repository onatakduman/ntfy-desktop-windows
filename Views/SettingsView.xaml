<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="NtfyDesktop.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:NtfyDesktop.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NtfyDesktop.Models"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Top app bar  -->
        <Border
            Grid.Row="0"
            Padding="24,14"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Settings" />
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24,16,24,24">
            <StackPanel HorizontalAlignment="Stretch" Spacing="8">
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Default server URL" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Pre-filled when subscribing or sending." />
                        </StackPanel>
                        <TextBox
                            Grid.Column="1"
                            MinWidth="260"
                            AutomationProperties.AutomationId="DefaultServerUrl"
                            Text="{x:Bind ViewModel.DefaultServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Background notifications" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Raise a Windows toast for each incoming message." />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            AutomationProperties.AutomationId="NotificationsToggle"
                            IsOn="{x:Bind ViewModel.NotificationsEnabled, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Notification sound" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Sound played when a new notification arrives." />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="180"
                            AutomationProperties.AutomationId="SoundSelector"
                            ItemsSource="{x:Bind ViewModel.SoundLabels}"
                            SelectedIndex="{x:Bind ViewModel.NotificationSoundIndex, Mode=TwoWay}" />
                        <Button
                            Grid.Column="2"
                            AutomationProperties.AutomationId="PreviewSoundButton"
                            Command="{x:Bind ViewModel.PreviewSoundCommand}"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Preview sound">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                        </Button>
                    </Grid>
                </Border>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Minimum priority" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Only show notifications at or above this priority." />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="160"
                            AutomationProperties.AutomationId="MinPrioritySelector"
                            SelectedIndex="{x:Bind ViewModel.MinPriorityIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Min and above" />
                            <ComboBoxItem Content="Low and above" />
                            <ComboBoxItem Content="Default and above" />
                            <ComboBoxItem Content="High and above" />
                            <ComboBoxItem Content="Max only" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Keep running in the tray" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Closing the window hides it and keeps streaming." />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            AutomationProperties.AutomationId="TrayToggle"
                            IsOn="{x:Bind ViewModel.MinimizeToTrayOnClose, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Appearance" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Light, dark, or follow the system." />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="160"
                            AutomationProperties.AutomationId="ThemeSelector"
                            SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="System" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Maximum stored messages" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Oldest messages are dropped beyond this limit." />
                        </StackPanel>
                        <NumberBox
                            Grid.Column="1"
                            MinWidth="160"
                            AutomationProperties.AutomationId="MaxHistory"
                            Maximum="100000"
                            Minimum="50"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind ViewModel.MaxHistory, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!--  Subscribed topics  -->
                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Subscribed topics" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="You are not subscribed to any topics yet."
                    Visibility="{x:Bind helpers:XamlHelpers.CountToInvertVisibility(ViewModel.Subscriptions.Count), Mode=OneWay}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Subscriptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Subscription">
                            <Border
                                Padding="12"
                                Margin="0,0,0,6"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="1">
                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Status, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Click="Unsubscribe_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="Unsubscribe">
                                        <FontIcon FontSize="15" Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Authentication  -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Authentication" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.AutomationId="AddCredentialButton"
                        Click="AddCredential_Click"
                        Content="Add" />
                </Grid>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Saved credentials are used automatically for matching servers."
                    TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.Credentials}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ServerCredential">
                            <Border
                                Padding="12"
                                Margin="0,0,0,6"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Glyph="&#xE72E;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind DisplayName}" />
                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="2">
                                        <Button
                                            Click="EditCredential_Click"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            ToolTipService.ToolTip="Edit">
                                            <FontIcon FontSize="15" Glyph="&#xE70F;" />
                                        </Button>
                                        <Button
                                            Click="RemoveCredential_Click"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            ToolTipService.ToolTip="Remove">
                                            <FontIcon FontSize="15" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Margin="4,8,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}">
                    <Run Text="{x:Bind ViewModel.AppVersion}" />
                    <LineBreak />
                    <Run Text="A desktop client for" />
                    <Hyperlink NavigateUri="https://ntfy.sh">ntfy.sh</Hyperlink>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
